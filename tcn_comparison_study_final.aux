\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces INT8 accuracy vs.\ model size (log scale). Green shaded region: $\le $512\,KB deployable budget. Red dashed line: 512\,KB Cortex-M7 flash limit. Models on the budget boundary (2g TCN at 266\,KB, 2a TCN at 268\,KB, ShuffleNet 4c at 476\,KB) are the only viable $>$85\% options. Models above 90\% accuracy all exceed budget, except TCNs.}}{3}{figure.2}\protected@file@percent }
\newlabel{fig:accsize}{{2}{3}{INT8 accuracy vs.\ model size (log scale). Green shaded region: $\le $512\,KB deployable budget. Red dashed line: 512\,KB Cortex-M7 flash limit. Models on the budget boundary (2g TCN at 266\,KB, 2a TCN at 268\,KB, ShuffleNet 4c at 476\,KB) are the only viable $>$85\% options. Models above 90\% accuracy all exceed budget, except TCNs}{figure.2}{}}
